{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "homework",
        "challenge",
        "typing",
        "project",
        "course",
        "certificate",
        "streak",
        "general"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string",
      "default": "\ud83d\udd14"
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ]
}