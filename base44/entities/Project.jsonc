{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Easy",
        "Beginner",
        "Intermediate",
        "Advanced",
        "Professional",
        "Enterprise"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Mini",
        "Intermediate",
        "Advanced",
        "Company",
        "Open Source",
        "Capstone"
      ]
    },
    "estimated_time": {
      "type": "string"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problem_statement": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "xp_reward": {
      "type": "number",
      "default": 100
    },
    "coin_reward": {
      "type": "number",
      "default": 50
    },
    "cover_image": {
      "type": "string"
    },
    "difficulty_level": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "title",
    "difficulty",
    "category"
  ]
}